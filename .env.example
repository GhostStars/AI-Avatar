IMAGE_PROVIDER=coze

# Coze / 扣子：推荐先用它，有免费额度时更适合 MVP 试水
COZE_PAT=pat-your-token-here
COZE_RUN_URL=https://your-space.coze.site/run
COZE_WORKFLOW_ID=your-workflow-id-here
COZE_BASE_URL=https://api.coze.cn
COZE_OUTPUT_KEY=image_url

# OpenAI：可留作备用
OPENAI_API_KEY=sk-your-key-here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low

# 支付宝支付
PAYMENT_PROVIDER=alipay
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-app-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/#/points

# 真实短信验证码：本地可用 mock；线上设为 aliyun
SMS_PROVIDER=mock
SMS_CODE_TTL_SECONDS=600
SMS_SEND_COOLDOWN_SECONDS=60
SMS_HOURLY_LIMIT=5
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-approved-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=SMS_your-login-template-code
# 可选：设置密码单独模板；不填则复用 ALIYUN_SMS_TEMPLATE_CODE
ALIYUN_SMS_SET_PASSWORD_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
